\newcounter{currentproblem} %incremented when 
\NewDocumentCommand{\currentproblemname}{}{}

\NewDocumentCommand{\newnotesproblem}{o}{
	\stepcounter{currentproblem}
	\IfNoValueTF{#1}{
		\RenewDocumentCommand{\currentproblemname}{}{Problem~\thecurrentproblem}
	}{
		\RenewDocumentCommand{\currentproblemname}{}{#1}
	}
	{\newpage \noindent\bfseries\Large \currentproblemname \newline}
}


